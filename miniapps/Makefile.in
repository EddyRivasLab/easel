top_srcdir = @top_srcdir@
srcdir     = @srcdir@
VPATH      = @srcdir@ 
SHELL      = /bin/sh

## Man page substitutions 
#
EASEL_VERSION   = @EASEL_VERSION@
EASEL_DATE      = @EASEL_DATE@
EASEL_COPYRIGHT = @EASEL_COPYRIGHT@
EASEL_LICENSE   = @EASEL_LICENSE@
EASEL_URL       = @EASEL_URL@

## Installation targets
#
prefix      = @prefix@
exec_prefix = @exec_prefix@
datarootdir = @datarootdir@
bindir      = @bindir@
libdir      = @libdir@
includedir  = @includedir@
mandir      = @mandir@
docdir      = @docdir@
pdfdir      = @pdfdir@
mandir      = @mandir@
man1dir     = ${mandir}/man1
man1ext     = .1

INSTALL     = @INSTALL@

## Compiler and compiler flags
#
CC             = @CC@
CFLAGS         = @CFLAGS@
PTHREAD_CFLAGS = @PTHREAD_CFLAGS@ 
CPPFLAGS       = @CPPFLAGS@
LDFLAGS        = @LDFLAGS@
DEFS           = @DEFS@
LIBS           = -leasel @LIBGSL@ @LIBS@ @PTHREAD_LIBS@ -lm

## List of the miniapp subcommands 
#
SUBCMDS = \
	afetch     \
	afetchn    \
	aindex     \
	alicol     \
	alimanip   \
	alimap     \
	alimerge   \
	alipid     \
	alirev     \
	alishuf    \
	alistat    \
	compalign  \
	compstruct \
	construct  \
	downsample \
	filter     \
	histplot   \
	kmer       \
	mask       \
	printseq   \
	reformat   \
	seqrange   \
	seqstat    \
	sfetch     \
	sfetchn    \
	sindex     \
	shuffle    \
	ssdraw     \
	synth      \
	translate  \
	weight

SUBCMDOBJS = $(SUBCMDS:%=cmd_%.o)                
MANPAGES   = easel.man $(SUBCMDS:%=easel-%.man)  


## Beautification magic stolen from git 
#
QUIET_SUBDIR0 = +${MAKE} -C #space separator after -c
QUIET_SUBDIR1 = 
ifndef V
	QUIET_CC      = @echo '    ' CC $@;
	QUIET_GEN     = @echo '    ' GEN $@;
	QUIET_AR      = @echo '    ' AR $@;
	QUIET_SUBDIR0 = +@subdir=
	QUIET_SUBDIR1 = ; echo '    ' SUBDIR  $$subdir; \
		        ${MAKE} -s -C $$subdir
endif


.PHONY: all dev tests check install uninstall clean distclean 

all: 	easel ${MANPAGES}
dev:    all
tests:  all
check:  all

easel:  % : %.c ../libeasel.a ${SUBCMDOBJS}
	${QUIET_GEN}${CC} ${CPPFLAGS} ${CFLAGS} ${PTHREAD_CFLAGS} ${DEFS} ${LDFLAGS} -L.. -I. -I.. -I${srcdir} -I${srcdir}/.. -o $@ $< ${SUBCMDOBJS} ${LIBS}

${SUBCMDOBJS}: %.o : %.c ../libeasel.a
	${QUIET_CC}${CC} -I. -I.. -I${srcdir} -I${srcdir}/.. ${CPPFLAGS} ${CFLAGS} ${PTHREAD_CFLAGS} ${SIMD_CFLAGS} ${DEFS} -c $<

# [@] in the sed patterns protects these from configure's output
# variable substitution; we need these target patterns to be literally
# @EASEL_VERSION@, etc.
# 
${MANPAGES}: %.man: %.man.in
	${QUIET_GEN}sed \
	   -e 's|[@]EASEL_VERSION[@]|${EASEL_VERSION}|g'     \
	   -e 's|[@]EASEL_DATE[@]|${EASEL_DATE}|g'           \
	   -e 's|[@]EASEL_COPYRIGHT[@]|${EASEL_COPYRIGHT}|g' \
	   -e 's|[@]EASEL_LICENSE[@]|${EASEL_LICENSE}|g'     \
	   -e 's|[@]EASEL_URL[@]|${EASEL_URL}|g'             \
	   $< > $@

install: easel ${MANPAGES}
	${INSTALL} -d ${DESTDIR}${bindir}
	${INSTALL} -d ${DESTDIR}${man1dir}
	${INSTALL} -m 0755 easel ${DESTDIR}${bindir}
	for p in easel $(SUBCMDS:%=easel-%); do \
	   ${INSTALL} -m 0644 $$p.man ${DESTDIR}${man1dir}/$$p${man1ext} ;\
	done

uninstall:
	-rm -f ${DESTDIR}${bindir}/easel
	for p in easel $(SUBCMDS:%=easel-%); do \
	   rm ${DESTDIR}${man1dir}/$$p${man1ext} ;\
	done

clean:
	-rm -f easel *.o *~ *.man
	-rm -f *.gcno *.gcda *.gcov TAGS
	-rm -rf easel.dSYM

distclean: clean
	-rm -f Makefile


